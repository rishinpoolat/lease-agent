# Copy to .env if you want to run services outside docker compose (docker
# compose itself sets these directly in docker-compose.yml -- this file is
# for running `uv run` / `npm run dev` against the compose-managed
# postgres/rabbitmq from the host instead).

DATABASE_URL=postgresql+asyncpg://lease_agent:lease_agent@localhost:5432/lease_agent
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
STORAGE_DIR=./data/uploads

NEXT_PUBLIC_API_URL=http://localhost:8000
